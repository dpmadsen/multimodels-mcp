@@ -0,0 +1,67 @@
+// Testes da montagem dos argumentos do CLI do Codex (buildCodexArgs).
+// A função é pura: recebe a tarefa e as opções e devolve o array de
+// argumentos — sem spawn, sem arquivos, sem rede.
+import { test } from "node:test";
+import assert from "node:assert/strict";
+import { buildCodexArgs } from "./codex.js";
+
+test("argumentos base: sem modelo nem esforço", () => {
+  const args = buildCodexArgs("faça algo", { outFile: "/tmp/out.txt" });
+  assert.deepEqual(args, [
+    "exec",
+    "--skip-git-repo-check",
+    "--sandbox",
+    "read-only",
+    "--output-last-message",
+    "/tmp/out.txt",
+    "faça algo",
+  ]);
+});
+
+test("inclui '-m <modelo>' quando o modelo é informado", () => {
+  const args = buildCodexArgs("tarefa", { outFile: "/tmp/o", model: "gpt-5.6-luna" });
+  const i = args.indexOf("-m");
+  assert.notEqual(i, -1, "deve conter a flag -m");
+  assert.equal(args[i + 1], "gpt-5.6-luna");
+});
+
+test("inclui '-c model_reasoning_effort=<esforço>' quando o esforço é informado", () => {
+  const args = buildCodexArgs("tarefa", { outFile: "/tmp/o", effort: "high" });
+  const i = args.indexOf("-c");
+  assert.notEqual(i, -1, "deve conter a flag -c");
+  assert.equal(args[i + 1], "model_reasoning_effort=high");
+});
+
+test("modelo e esforço juntos vêm antes da tarefa (último argumento posicional)", () => {
+  const args = buildCodexArgs("minha tarefa", {
+    outFile: "/o",
+    model: "gpt-5.6-luna",
+    effort: "xhigh",
+  });
+  assert.equal(args[args.length - 1], "minha tarefa", "a tarefa deve ser o último argumento");
+  assert.ok(args.indexOf("-m") < args.length - 1, "-m deve vir antes da tarefa");
+  assert.ok(args.indexOf("-c") < args.length - 1, "-c deve vir antes da tarefa");
+});
+
+test("todos os esforços válidos são aceitos", () => {
+  for (const effort of ["low", "medium", "high", "xhigh"]) {
+    const args = buildCodexArgs("t", { outFile: "/o", effort });
+    assert.ok(
+      args.includes(`model_reasoning_effort=${effort}`),
+      `esforço ${effort} deveria ser aceito`
+    );
+  }
+});
+
+test("esforço inválido lança erro listando os válidos", () => {
+  assert.throws(
+    () => buildCodexArgs("t", { outFile: "/o", effort: "turbo" }),
+    /Esforço de raciocínio inválido.*low.*medium.*high.*xhigh/
+  );
+});
+
+test("esforço vazio não dispara erro (ausente, não inválido)", () => {
+  // effort undefined é simplesmente ignorado — não deve adicionar a flag -c.
+  const args = buildCodexArgs("t", { outFile: "/o" });
+  assert.equal(args.indexOf("-c"), -1);
+});
