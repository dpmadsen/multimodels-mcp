+// Valores aceitos pelo Codex para o nível de raciocínio do modelo.
+const VALID_EFFORTS = ["low", "medium", "high", "xhigh"] as const;
+
+// Monta os argumentos passados ao `codex` (sem incluir o próprio executável).
+// Função pura — só organiza o array a partir das opções, sem efeitos colaterais.
+export function buildCodexArgs(
+  task: string,
+  opts: { outFile: string; model?: string; effort?: string }
+): string[] {
+  const args: string[] = [
+    "exec",
+    "--skip-git-repo-check",
+    "--sandbox",
+    "read-only",
+    "--output-last-message",
+    opts.outFile,
+  ];
+  if (opts.model) {
+    args.push("-m", opts.model);
+  }
+  if (opts.effort) {
+    if (!VALID_EFFORTS.includes(opts.effort as (typeof VALID_EFFORTS)[number])) {
+      throw new Error(
+        `Esforço de raciocínio inválido: "${opts.effort}". ` +
+          `Valores válidos: ${VALID_EFFORTS.join(", ")}.`
+      );
+    }
+    args.push("-c", `model_reasoning_effort=${opts.effort}`);
+  }
+  // A tarefa é o argumento posicional final: as opções (-m, -c, etc.)
+  // precisam vir antes dela, como o CLI espera.
+  args.push(task);
+  return args;
+}
