+// Testes da montagem de argumentos do CLI do Codex.
+// Cobrem os caminhos felizes (com/sem modelo, com/sem esforço) e os de erro
+// (esforço inválido). Não chamam o `codex` de verdade: testam só buildCodexArgs,
+// que é uma função pura.
+import { test } from "node:test";
+import assert from "node:assert/strict";
+import { buildCodexArgs } from "./codex.js";
+
+test("monta argumentos básicos quando modelo e esforço não vêm", () => {
+  const args = buildCodexArgs("faça algo", { outFile: "/tmp/out.txt" });
+  assert.deepEqual(args, [
+    "exec",
+    "--skip-git-repo-check",
+    "--sandbox", "read-only",
+    "--output-last-message", "/tmp/out.txt",
+    "faça algo",
+  ]);
+});
+
+test("inclui -m <modelo> antes da tarefa quando modelo é informado", () => {
+  const args = buildCodexArgs("faça algo", { outFile: "/tmp/out.txt", model: "gpt-5.6-luna" });
+  assert.deepEqual(args, [
+    "exec",
+    "--skip-git-repo-check",
+    "--sandbox", "read-only",
+    "--output-last-message", "/tmp/out.txt",
+    "-m", "gpt-5.6-luna",
+    "faça algo",
+  ]);
+});
+
+test("inclui -c model_reasoning_effort=<effort> para esforço válido", () => {
+  for (const effort of ["low", "medium", "high", "xhigh"] as const) {
+    const args = buildCodexArgs("tarefa", { outFile: "/tmp/o.txt", effort });
+    assert.ok(args.includes("-c"), `esperava -c para effort=${effort}`);
+    assert.ok(args.includes(`model_reasoning_effort=${effort}`), `esperava config para effort=${effort}`);
+    // A tarefa continua sendo o último argumento.
+    assert.equal(args[args.length - 1], "tarefa");
+  }
+});
+
+test("aceita modelo e esforço juntos, ambos antes da tarefa", () => {
+  const args = buildCodexArgs("tarefa", {
+    outFile: "/tmp/o.txt",
+    model: "gpt-5.6-sol",
+    effort: "high",
+  });
+  const taskIndex = args.indexOf("tarefa");
+  const modelIndex = args.indexOf("-m");
+  const effortIndex = args.indexOf("-c");
+  assert.ok(taskIndex > -1 && modelIndex > -1 && effortIndex > -1);
+  assert.ok(modelIndex < taskIndex, "modelo deve vir antes da tarefa");
+  assert.ok(effortIndex < taskIndex, "esforço deve vir antes da tarefa");
+});
+
+test("lança erro amigável para esforço inválido, listando os válidos", () => {
+  assert.throws(
+    () => buildCodexArgs("tarefa", { outFile: "/tmp/o.txt", effort: "turbo" }),
+    (err: unknown) => {
+      assert.ok(err instanceof Error, "deve ser um Error");
+      const msg = err.message;
+      assert.ok(msg.includes("turbo"), "mensagem cita o valor inválido");
+      assert.ok(msg.includes("low"), "lista low");
+      assert.ok(msg.includes("medium"), "lista medium");
+      assert.ok(msg.includes("high"), "lista high");
+      assert.ok(msg.includes("xhigh"), "lista xhigh");
+      return true;
+    }
+  );
+});
