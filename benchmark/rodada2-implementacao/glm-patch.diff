+// Valores aceitos pelo Codex para esforço de raciocínio.
+const VALID_EFFORTS = ["low", "medium", "high", "xhigh"] as const;
+type Effort = (typeof VALID_EFFORTS)[number];
+
+function isEffort(value: string): value is Effort {
+  return (VALID_EFFORTS as readonly string[]).includes(value);
+}
+
+/**
+ * Monta os argumentos passados ao `codex` (sem incluir o próprio executável).
+ * Função pura — fácil de testar isoladamente. A tarefa sempre vem por último,
+ * porque o CLI recebe a instrução como argumento posicional final.
+ */
+export function buildCodexArgs(
+  task: string,
+  opts: { outFile: string; model?: string; effort?: string }
+): string[] {
+  // Argumentos fixos de hoje em dia — mantemos exatamente estes.
+  const args: string[] = [
+    "exec",
+    "--skip-git-repo-check",
+    "--sandbox", "read-only",
+    "--output-last-message", opts.outFile,
+  ];
+
+  // Modelo da família GPT-5.6 (sol/terra/luna). Vai antes da tarefa.
+  if (opts.model !== undefined) {
+    args.push("-m", opts.model);
+  }
+
+  // Esforço de raciocínio. Validamos aqui para falhar cedo, com mensagem
+  // amigável, antes mesmo de chamar o CLI.
+  if (opts.effort !== undefined) {
+    if (!isEffort(opts.effort)) {
+      throw new Error(
+        `Esforço de raciocínio inválido: "${opts.effort}". ` +
+          `Use um destes: ${VALID_EFFORTS.join(", ")}.`
+      );
+    }
+    args.push("-c", `model_reasoning_effort=${opts.effort}`);
+  }
+
+  // A instrução (tarefa) é sempre o último argumento posicional.
+  args.push(task);
+  return args;
+}
