+// Testes da resolução de ids do provedor Codex (formato "codex" e "codex:<modelo>").
+// Usam uma configuração de mentira, isolada do config/models.json real.
+import { test } from "node:test";
+import assert from "node:assert/strict";
+import { resolveModel, type ModelsConfig } from "./config.js";
+
+const fixtureComModelos: ModelsConfig = {
+  providers: {
+    codex: {
+      type: "codex-cli",
+      label: "Codex (assinatura ChatGPT)",
+      enabled: true,
+      models: ["gpt-5.6-sol", "gpt-5.6-terra", "gpt-5.6-luna"],
+    },
+  },
+};
+
+const fixtureSemModelos: ModelsConfig = {
+  providers: {
+    codex: { type: "codex-cli", label: "Codex", enabled: true },
+  },
+};
+
+test("'codex' segue funcionando sem nome de modelo (compatibilidade)", () => {
+  const ref = resolveModel(fixtureComModelos, "codex");
+  assert.equal(ref.provider.type, "codex-cli");
+  assert.equal(ref.model, undefined);
+});
+
+test("'codex:<modelo>' válido devolve o modelo preenchido", () => {
+  const ref = resolveModel(fixtureComModelos, "codex:gpt-5.6-luna");
+  assert.equal(ref.provider.type, "codex-cli");
+  assert.equal(ref.model, "gpt-5.6-luna");
+});
+
+test("'codex:<modelo>' fora da lista gera erro amigável citando os habilitados", () => {
+  assert.throws(
+    () => resolveModel(fixtureComModelos, "codex:gpt-4"),
+    (err: unknown) => {
+      assert.ok(err instanceof Error);
+      const msg = err.message;
+      assert.ok(msg.includes("gpt-4"), "cita o modelo rejeitado");
+      assert.ok(msg.includes("gpt-5.6-sol"));
+      assert.ok(msg.includes("gpt-5.6-terra"));
+      assert.ok(msg.includes("gpt-5.6-luna"));
+      return true;
+    }
+  );
+});
+
+test("'codex:<modelo>' com lista vazia explica que nenhum modelo está habilitado", () => {
+  assert.throws(
+    () => resolveModel(fixtureSemModelos, "codex:gpt-5.6-luna"),
+    (err: unknown) => {
+      assert.ok(err instanceof Error);
+      const msg = err.message;
+      assert.ok(/nenhum modelo explícito/i.test(msg), "explica ausência de modelos explícitos");
+      assert.ok(/modelo padrão/i.test(msg), "menciona o modelo padrão do CLI");
+      return true;
+    }
+  );
+});
+
+test("aceita modelo com dois-pontos (id normalizado via join)", () => {
+  // Garante que split/join preserva modelos com ":" no nome, se houver.
+  const fixture: ModelsConfig = {
+    providers: {
+      codex: { type: "codex-cli", label: "Codex", enabled: true, models: ["familia:variante"] },
+    },
+  };
+  const ref = resolveModel(fixture, "codex:familia:variante");
+  assert.equal(ref.model, "familia:variante");
+});
