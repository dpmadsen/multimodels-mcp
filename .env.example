# Copy this file to .env and fill in the keys for the providers you actually use.
# Keys are loaded by the server at startup and are NEVER committed (.env is gitignored).
#
# Copie este arquivo para .env e preencha as chaves dos provedores que você usa.

# DeepSeek direct API (https://platform.deepseek.com)
DEEPSEEK_API_KEY=

# z.ai — NOTE: coding-plan subscription keys only work with the coding endpoint
# (https://api.z.ai/api/coding/paas/v4). The default models.json already points there.
ZAI_API_KEY=

# OpenRouter (https://openrouter.ai/keys)
OPENROUTER_API_KEY=

# Moonshot / Kimi official API (https://platform.kimi.ai) — used by the
# "Kimi with hands" lane. This is NOT the OpenRouter key.
#
# Moonshot / Kimi, chave oficial: usada pela raia "Kimi com mãos".
MOONSHOT_API_KEY=

# LM Studio (local or LAN) and the Codex CLI need no keys here.
